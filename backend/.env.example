APP_NAME="MRM Zone Shop"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Dhaka
# Public URL of this API (uploaded images are served from here)
APP_URL=https://api.mrmzone.shop

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# MySQL on the VPS (Docker setup uses host "mysql")
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mrmzone_shop
DB_USERNAME=mrmzone
DB_PASSWORD=change-this-strong-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# Redis is optional: set CACHE_STORE=redis to use it
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@mrmzone.shop"
MAIL_FROM_NAME="${APP_NAME}"

# Which websites may call this API from the browser (comma separated, no trailing slash)
CORS_ALLOWED_ORIGINS=https://mrmzone.shop,https://www.mrmzone.shop

# First admin account (created by `php artisan db:seed`)
ADMIN_NAME="MRM Zone Admin"
ADMIN_EMAIL=admin@mrmzone.shop
ADMIN_PASSWORD=
ADMIN_PHONE=

# Set to true once to load the demo catalog in production (then set back to false)
SEED_DEMO=false
