# Laravel API base (must include /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Public site URL (used for canonical URLs / Open Graph)
NEXT_PUBLIC_SITE_URL=https://mrmzone.shop
# true = use built-in demo catalog + demo admin (no backend needed). Admin demo login: admin@mrmzone.shop / demo
NEXT_PUBLIC_DEMO_MODE=false
